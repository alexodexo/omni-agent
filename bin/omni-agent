#!/usr/bin/env python3
"""Omni-Agent core. Finds its library through its own file path (also through a symlink),
because ${CLAUDE_PLUGIN_ROOT} is not set in Bash tool commands."""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("Omni-Agent needs Python 3.9 or newer.")

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from omni_agent.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
